MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?appName=<app>
JWT_SECRET=<gere-uma-chave-aleatoria-longa>
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=<defina-uma-senha-forte>
PORT=3001
FRONTEND_URL=http://localhost:3000

# Mercado Pago — Access Token (Checkout Pro) da conta própria da loja. NUNCA commitar o valor real.
MP_ACCESS_TOKEN=APP_USR-...
MERCADOPAGO_PUBLIC_KEY=APP_USR-...
# URL pública https desta API para o webhook do MP (ex.: https://loja-feltros-api.fly.dev)
PUBLIC_API_URL=
# URL completa da página de retorno do checkout (inclui basePath se houver)
CHECKOUT_RETURN_URL=

# Cloudinary — armazenamento persistente das imagens dos produtos
# (console.cloudinary.com/app/settings/api-keys) — conta própria da loja
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Melhor Envio — cotação e etiquetas de frete (conta própria da loja)
MELHORENVIO_CLIENT_ID=
MELHORENVIO_CLIENT_SECRET=
MELHORENVIO_SANDBOX=true
MELHORENVIO_USER_AGENT=loja-feltros (seu-email@exemplo.com)
MELHORENVIO_FROM_CEP=
# Remetente da etiqueta (fase 2 — compra de etiqueta)
MELHORENVIO_FROM_NAME=
MELHORENVIO_FROM_PHONE=
MELHORENVIO_FROM_EMAIL=
# Preencha CPF ou CNPJ, nunca os dois
MELHORENVIO_FROM_CPF=
MELHORENVIO_FROM_CNPJ=
MELHORENVIO_FROM_ADDRESS=
MELHORENVIO_FROM_NUMBER=
MELHORENVIO_FROM_COMPLEMENT=
MELHORENVIO_FROM_DISTRICT=
MELHORENVIO_FROM_CITY=
MELHORENVIO_FROM_STATE=
